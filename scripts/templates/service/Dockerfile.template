# Build stage
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./

# Copy shared packages
COPY shared/libs ./shared/libs
COPY shared/contracts ./shared/contracts
COPY shared/events ./shared/events

# Copy this service
COPY {{SERVICE_PATH}} ./{{SERVICE_PATH}}

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build shared packages first
RUN pnpm build:shared

# Build this service
RUN pnpm --filter @ecosystem/{{SERVICE_NAME}} build

# Production stage
FROM node:20-alpine AS runner

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

ENV NODE_ENV=production

# Copy built artifacts
COPY --from=builder /app/{{SERVICE_PATH}}/dist ./dist
COPY --from=builder /app/{{SERVICE_PATH}}/package.json ./
COPY --from=builder /app/node_modules ./node_modules

# Copy prisma schema if exists
COPY --from=builder /app/{{SERVICE_PATH}}/prisma ./prisma 2>/dev/null || true

# Generate prisma client
RUN npx prisma generate 2>/dev/null || true

EXPOSE 3000

CMD ["node", "dist/index.js"]
