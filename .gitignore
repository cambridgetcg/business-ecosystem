# =============================================================================
# Business Ecosystem - Git Ignore
# =============================================================================

# Python tooling (never commit local environments or test state)
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*

# Estate layer private area: never committed (decision dec-2026-10-17-1,
# docs/PORTFOLIO_MAP.md). The layer's own ignore files exclude it as well.
/estate/private/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Turbo
.turbo/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Database
*.sqlite
*.sqlite3

# Generated
src/**/generated/
# One Prisma client per schema, written by the package's db:generate script
**/generated/prisma/

# Docker volumes (if stored locally)
.docker-data/

# Temporary files
tmp/
temp/
*.tmp

# Secrets (never commit)
*.pem
*.key
credentials.json
secrets/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

