{
  "name": "business-ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build $(node scripts/ci-quarantine.mjs build)",
    "build:shared": "turbo run build --filter='./shared/**'",
    "build:foundational": "turbo run build --filter='./foundational/**'",
    "build:operational": "turbo run build --filter='./operational/**'",
    "test": "turbo run test",
    "test:ci": "turbo run test $(node scripts/ci-quarantine.mjs test)",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint $(node scripts/ci-quarantine.mjs lint)",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "typecheck:ci": "turbo run typecheck $(node scripts/ci-quarantine.mjs typecheck)",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev": "turbo run dev",
    "dev:operational": "turbo run dev --filter='./operational/**'",
    "dev:foundational": "turbo run dev --filter='./foundational/**'",
    "db:migrate": "turbo run db:migrate",
    "db:generate": "turbo run db:generate",
    "db:seed": "turbo run db:seed",
    "docker:up": "docker-compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker-compose.yml down",
    "scaffold:service": "tsx scripts/scaffold-service.ts",
    "progress": "tsx scripts/generate-progress.ts",
    "progress:check": "tsx scripts/check-progress-files.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yaml,yml}": ["prettier --write"]
  }
}
