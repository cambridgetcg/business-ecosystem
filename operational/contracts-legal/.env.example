# Contracts & Legal Service Environment Configuration

# ============================================================================
# DATABASE (AWS RDS PostgreSQL)
# ============================================================================

# Local development
DATABASE_URL="postgresql://postgres:password@localhost:5432/contracts_legal?schema=public"

# AWS RDS (production)
# Format: postgresql://username:password@host:port/database?schema=public&sslmode=require
# DATABASE_URL="postgresql://admin:password@contracts-legal-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/contracts_legal?schema=public&sslmode=require"

# AWS RDS IAM Authentication (recommended for production)
# Use RDS Proxy for connection pooling
# DATABASE_URL="postgresql://admin@contracts-legal-proxy.proxy-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/contracts_legal?schema=public&sslmode=require"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_RDS_INSTANCE_ID="contracts-legal-db"
AWS_RDS_USE_IAM_AUTH="false"

# ============================================================================
# AWS S3 (Document Storage)
# ============================================================================

AWS_S3_BUCKET="ecosystem-contracts-documents"
AWS_S3_REGION="us-east-1"

# ============================================================================
# AWS KMS (Encryption)
# ============================================================================

AWS_KMS_KEY_ID="alias/contracts-legal-encryption"

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

NODE_ENV="development"
PORT="3011"
HOST="0.0.0.0"

# Service name for logging/tracing
SERVICE_NAME="contracts-legal"
SERVICE_VERSION="0.1.0"

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL="info"
LOG_FORMAT="json"

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT configuration (via @ecosystem/auth)
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRY="1h"

# ============================================================================
# INTERNAL SERVICES
# ============================================================================

# Messaging service
MESSAGING_URL="amqp://localhost:5672"

# Auth service
AUTH_SERVICE_URL="http://localhost:3001"

# Audit logging service
AUDIT_SERVICE_URL="http://localhost:3002"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_AUDIT_LOGGING="true"
ENABLE_ENCRYPTION="true"
ENABLE_NOTIFICATIONS="true"
