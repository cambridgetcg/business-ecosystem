{
  "name": "@ecosystem/contracts-legal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#prisma": "./generated/prisma/index.js"
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc",
    "dev": "pnpm run db:generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "lint": "pnpm run db:generate && eslint src --ext .ts",
    "lint:fix": "pnpm run db:generate && eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "db:generate": "CHECKPOINT_DISABLE=1 node ../../scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rds": "^3.500.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/lib-storage": "^3.500.0",
    "@aws-sdk/rds-signer": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@ecosystem/audit-logging": "workspace:*",
    "@ecosystem/auth": "workspace:*",
    "@ecosystem/config": "workspace:*",
    "@ecosystem/contracts-document": "workspace:*",
    "@ecosystem/contracts-entity": "workspace:*",
    "@ecosystem/database": "workspace:*",
    "@ecosystem/encryption": "workspace:*",
    "@ecosystem/events-legal": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/messaging": "workspace:*",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/validation": "workspace:*",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.7.6",
    "@paralleldrive/cuid2": "^2.2.0",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.0.0",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "nanoid": "^5.0.0",
    "pdf-lib": "^1.17.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@types/node": "^20.10.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
