{
  "name": "@ecosystem/intellectual-property",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect:pg"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@ecosystem/audit-logging": "workspace:*",
    "@ecosystem/auth": "workspace:*",
    "@ecosystem/config": "workspace:*",
    "@ecosystem/contracts-document": "workspace:*",
    "@ecosystem/database": "workspace:*",
    "@ecosystem/encryption": "workspace:*",
    "@ecosystem/events-legal": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/messaging": "workspace:*",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/validation": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@sentry/node": "^8.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.29.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.0",
    "lru-cache": "^10.2.0",
    "nanoid": "^5.0.0",
    "pdf-lib": "^1.17.0",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "reflect-metadata": "^0.2.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.20.0",
    "supertest": "^6.3.0",
    "testcontainers": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
