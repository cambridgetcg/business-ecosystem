# Intellectual Property Infrastructure Configuration
# Copy this file to terraform.tfvars and customize for your environment

################################################################################
# Core Settings
################################################################################

environment = "dev"
aws_region  = "us-east-1"

################################################################################
# EventBridge Configuration
################################################################################

enable_event_archive         = true
event_archive_retention_days = 90

################################################################################
# Deadline Configuration
################################################################################

deadline_alert_days       = [90, 60, 30, 14, 7, 3, 1]
enable_deadline_scheduler = true

################################################################################
# Audit Configuration
################################################################################

audit_log_retention_cloudwatch = 90
audit_log_retention_s3         = 2555  # 7 years
application_log_retention_days = 30

################################################################################
# Notification Configuration
################################################################################

alert_email                = "ip-alerts@example.com"
# slack_webhook_url        = ""  # Set via environment variable for security
enable_email_notifications = true

################################################################################
# S3 Document Storage Configuration
################################################################################

enable_s3_intelligent_tiering = false
patent_retention_years        = 20
trademark_retention_years     = 14
domain_retention_years        = 10

################################################################################
# DynamoDB Configuration
################################################################################

dynamodb_billing_mode = "PAY_PER_REQUEST"

################################################################################
# Feature Flags
################################################################################

# Enable MFA delete requires manual AWS CLI setup after apply
enable_trade_secret_mfa_delete = false

# Enable cross-service event publishing
enable_cross_service_events = true

# Enable Step Functions for IP workflows
enable_step_functions = true

# Enable Lambda for deadline evaluation
enable_deadline_lambda = true
