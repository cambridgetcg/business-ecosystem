{
  "name": "@ecosystem/data-privacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#prisma": "./generated/prisma/index.js"
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "lint": "pnpm run db:generate && eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "CHECKPOINT_DISABLE=1 prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@ecosystem/audit-logging": "workspace:*",
    "@ecosystem/auth": "workspace:*",
    "@ecosystem/config": "workspace:*",
    "@ecosystem/contracts-identity": "workspace:*",
    "@ecosystem/database": "workspace:*",
    "@ecosystem/encryption": "workspace:*",
    "@ecosystem/events-compliance": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/messaging": "workspace:*",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-ses": "^3.500.0",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@paralleldrive/cuid2": "^2.2.0",
    "@prisma/client": "^5.10.0",
    "@react-pdf/renderer": "^3.4.0",
    "@sentry/node": "^8.0.0",
    "amqplib": "^0.10.9",
    "bullmq": "^5.0.0",
    "date-fns": "^3.6.0",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "nodemailer": "^6.9.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
