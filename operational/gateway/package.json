{
  "name": "@ecosystem/operational-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified API gateway for cross-operational queries",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@ecosystem/config": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/service-client": "workspace:*",
    "@hono/node-server": "^1.8.0",
    "@hono/swagger-ui": "^0.4.0",
    "@hono/zod-openapi": "^0.18.0",
    "@sentry/node": "^8.0.0",
    "hono": "^4.0.0",
    "hono-rate-limiter": "^0.4.0",
    "nanoid": "^5.0.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
