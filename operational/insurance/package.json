{
  "name": "@ecosystem/insurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@ecosystem/audit-logging": "workspace:*",
    "@ecosystem/auth": "workspace:*",
    "@ecosystem/config": "workspace:*",
    "@ecosystem/contracts-entity": "workspace:*",
    "@ecosystem/contracts-financial": "workspace:*",
    "@ecosystem/database": "workspace:*",
    "@ecosystem/encryption": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/messaging": "workspace:*",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/validation": "workspace:*",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@paralleldrive/cuid2": "^2.2.0",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.0.0",
    "date-fns": "^3.6.0",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "pdf-lib": "^1.17.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
