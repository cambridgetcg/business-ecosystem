# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/entity_governance

# Cache (Redis) - Optional
REDIS_URL=redis://localhost:6379

# Message Broker (RabbitMQ) - Optional
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Observability (OpenTelemetry) - Optional
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=entity-governance

# AWS Configuration (Production)
AWS_REGION=us-east-1
# AWS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:entity-governance/development/db-credentials-AbCdEf

# Integration Services (Optional - for cross-service communication)
# ACCOUNTING_SERVICE_URL=http://accounting:3000
# TAX_SERVICE_URL=http://tax:3000
# COMPLIANCE_SERVICE_URL=http://compliance:3000
