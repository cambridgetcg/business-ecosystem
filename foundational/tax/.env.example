# UK Tax Service Configuration

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/tax_db

# Optional - Messaging
RABBITMQ_URL=amqp://localhost:5672

# Optional - Caching
REDIS_URL=redis://localhost:6379

# Server
PORT=3005
NODE_ENV=development
LOG_LEVEL=debug

# Security (required in production)
JWT_SECRET=your-secret-key-at-least-32-characters
COOKIE_SECRET=your-cookie-secret-at-least-32-characters

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# AWS Configuration (for production)
AWS_REGION=eu-west-2
AWS_SECRET_ARN=
AWS_KMS_KEY_ID=

# Service URLs (for inter-service communication)
ENTITY_GOVERNANCE_SERVICE_URL=http://localhost:3002
ACCOUNTING_SERVICE_URL=http://localhost:3001

# HMRC MTD API (future)
HMRC_API_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tax
