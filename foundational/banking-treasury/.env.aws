# AWS Deployment Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Use AWS Secrets Manager for database credentials
USE_AWS_SECRETS=true
DB_CREDENTIALS_SECRET=business-ecosystem/database-credentials

# AWS Configuration
AWS_REGION=us-east-1

# SNS/SQS
SNS_BANKING_TREASURY_TOPIC=arn:aws:sns:us-east-1:034362054546:business-ecosystem-banking-treasury-events
SQS_EVENTS_QUEUE=https://sqs.us-east-1.amazonaws.com/034362054546/business-ecosystem-banking-treasury-events-queue

# Redis/ElastiCache Configuration
# Host will be populated once ElastiCache is available
REDIS_HOST=business-ecosystem-cache.jhgio5.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300

# Feature Flags
ENABLE_EVENT_PUBLISHING=true
