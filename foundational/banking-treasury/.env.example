# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration
# Option 1: Direct connection string (for local development)
DATABASE_URL=postgresql://user:password@localhost:5432/banking_treasury

# Option 2: AWS Secrets Manager (for AWS deployment)
# USE_AWS_SECRETS=true
# DB_CREDENTIALS_SECRET=business-ecosystem/database-credentials

# AWS Configuration
AWS_REGION=us-east-1

# SNS/SQS (optional - for event publishing)
SNS_BANKING_TREASURY_TOPIC=arn:aws:sns:us-east-1:034362054546:business-ecosystem-banking-treasury-events
SQS_EVENTS_QUEUE=https://sqs.us-east-1.amazonaws.com/034362054546/business-ecosystem-banking-treasury-events-queue

# Feature Flags
ENABLE_EVENT_PUBLISHING=true

# Redis/Cache Configuration
# Option 1: Redis URL (for simple setups)
# REDIS_URL=redis://localhost:6379

# Option 2: Host/Port (for ElastiCache or custom setups)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cache settings
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300
