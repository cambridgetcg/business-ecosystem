{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecosystem:events:commerce.sale:v1",
  "title": "Commerce sale events, contract version 1",
  "description": "Envelope = @ecosystem/events-financial baseDomainEventSchema (shared/events/financial-events/src/index.ts:12-29), made strict. Money is integer minor units of payload.currency, as in @ecosystem/contracts-financial moneySchema (shared/contracts/financial/src/index.ts:16-19). Cross-field rules JSON Schema cannot express (id/aggregateId derivation, key = provider fields, totals = sums, refund caps) are listed in x-semantic-rules and enforced by the zod superRefine and the Python consumer.",
  "oneOf": [
    {
      "$ref": "#/$defs/saleRecordedEvent"
    },
    {
      "$ref": "#/$defs/saleRefundedEvent"
    }
  ],
  "x-semantic-rules": [
    "S1 id = UUIDv5(COMMERCE_EVENT_NAMESPACE, payload.idempotencyKey)",
    "S2 aggregateId = UUIDv5(COMMERCE_EVENT_NAMESPACE, 'sale|' + saleKey), where saleKey is payload.idempotencyKey for commerce.sale.recorded and payload.saleIdempotencyKey for commerce.sale.refunded",
    "S3 payload.idempotencyKey = 'v1|' + provider.name + '|' + provider.accountRef + '|' + provider.transactionType + '|' + provider.transactionId",
    "S4 recorded: totals.gross = sum(lines.net + lines.tax); totals.fees = sum(fees.net + fees.tax); totals.net = totals.gross - totals.fees",
    "S5 refunded: totals.gross = sum(lines.net + lines.tax); totals.feeCredits = sum(feeCredits.net + feeCredits.tax); totals.net = totals.gross - totals.feeCredits",
    "S6 lineRef values are unique within an event; feeRef values are unique within an event",
    "S7 refunded: the referenced sale exists, has the same booksOf.entityId, currency, channel and provider.accountRef; every lineRef and feeRef names a line or fee of that sale; cumulative refunds per line (net and tax separately) and per fee never exceed the sale's amounts",
    "S8 taxTreatment 'zero_rated', 'exempt', 'outside_scope' or 'margin_scheme' implies tax = 0 on that line; taxBasis 'not_applicable' iff tax = 0",
    "S9 payload.taxPointDate is the supply (or credit) date in the books' VAT calendar time zone (Europe/London for a UK entity), stated by the adapter so every consumer buckets periods identically",
    "S10 replay equality = SHA-256 of canonical JSON of {type, version, aggregateId, occurredAt, payload}; metadata is trace data and is excluded"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "calendarDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minorUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000
    },
    "signedMinorUnits": {
      "type": "integer",
      "minimum": -100000000000,
      "maximum": 100000000000
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "providerName": {
      "enum": [
        "synthetic",
        "ebay",
        "stripe",
        "shopify_partner",
        "bank_statement",
        "manual"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^v1\\|(synthetic|ebay|stripe|shopify_partner|bank_statement|manual)\\|[A-Za-z0-9._:-]{1,64}\\|[A-Za-z_]{1,40}\\|[A-Za-z0-9._:/-]{1,128}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlationId",
        "source",
        "timestamp"
      ],
      "properties": {
        "correlationId": {
          "$ref": "#/$defs/uuid"
        },
        "causationId": {
          "$ref": "#/$defs/uuid"
        },
        "userId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "source": {
          "type": "string",
          "pattern": "^commerce-intake/[a-z0-9-]{1,40}@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "timestamp": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "evidenceClass": {
      "description": "synthetic = invented fixture; recorded = a real provider record replayed offline; live = read from a provider at run time. Consumers refuse any class their activation state does not allow.",
      "enum": [
        "synthetic",
        "recorded",
        "live"
      ]
    },
    "booksOf": {
      "description": "The legal entity whose ledger this fact belongs to. A consumer posts only when entityId is one of the books it keeps; anything else is refused, never posted. decisionRef names the owner decision (or synthetic fixture) that assigned the entity: it is never derived from a repository or account name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "decisionRef"
      ],
      "properties": {
        "entityId": {
          "$ref": "#/$defs/uuid"
        },
        "decisionRef": {
          "type": "string",
          "pattern": "^(dec-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+|synthetic-[a-z0-9-]{1,40})$"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "marketplace",
            "storefront",
            "direct_b2b",
            "in_person"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "accountRef",
        "transactionType",
        "transactionId"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/providerName"
        },
        "accountRef": {
          "$ref": "#/$defs/ref",
          "description": "Opaque, non-secret identifier of the seller account at the provider."
        },
        "transactionType": {
          "type": "string",
          "pattern": "^[A-Za-z_]{1,40}$",
          "description": "The provider's own type, e.g. eBay SALE/REFUND, Stripe charge/refund."
        },
        "transactionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "description": "The provider's raw id (eBay transactionId, Stripe txn_..., Shopify GID). Not a UUID."
        },
        "orderRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      }
    },
    "counterparty": {
      "description": "No names, emails, usernames or addresses: only what VAT treatment needs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "country"
      ],
      "properties": {
        "kind": {
          "enum": [
            "consumer",
            "business",
            "unknown"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 of the delivery destination; ZZ when unknown."
        }
      }
    },
    "saleLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineRef",
        "revenueClass",
        "quantity",
        "net",
        "tax",
        "taxTreatment",
        "taxRateBp",
        "taxBasis"
      ],
      "properties": {
        "lineRef": {
          "$ref": "#/$defs/ref"
        },
        "revenueClass": {
          "enum": [
            "goods",
            "shipping"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "net": {
          "$ref": "#/$defs/minorUnits"
        },
        "tax": {
          "$ref": "#/$defs/minorUnits"
        },
        "taxTreatment": {
          "enum": [
            "standard_rated",
            "reduced_rated",
            "zero_rated",
            "exempt",
            "outside_scope",
            "margin_scheme"
          ]
        },
        "taxRateBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Rate in basis points: 2000 = 20%."
        },
        "taxBasis": {
          "enum": [
            "source_stated",
            "derived_from_inclusive",
            "not_applicable"
          ]
        }
      }
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feeRef",
        "feeType",
        "net",
        "tax",
        "taxTreatment"
      ],
      "properties": {
        "feeRef": {
          "$ref": "#/$defs/ref"
        },
        "feeType": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,40}$"
        },
        "net": {
          "$ref": "#/$defs/minorUnits"
        },
        "tax": {
          "$ref": "#/$defs/minorUnits"
        },
        "taxTreatment": {
          "enum": [
            "standard_rated",
            "exempt",
            "outside_scope",
            "reverse_charge"
          ]
        }
      }
    },
    "refundLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineRef",
        "net",
        "tax"
      ],
      "properties": {
        "lineRef": {
          "$ref": "#/$defs/ref"
        },
        "net": {
          "$ref": "#/$defs/minorUnits"
        },
        "tax": {
          "$ref": "#/$defs/minorUnits"
        }
      }
    },
    "feeCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feeRef",
        "net",
        "tax"
      ],
      "properties": {
        "feeRef": {
          "$ref": "#/$defs/ref"
        },
        "net": {
          "$ref": "#/$defs/minorUnits"
        },
        "tax": {
          "$ref": "#/$defs/minorUnits"
        }
      }
    },
    "saleRecordedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceClass",
        "booksOf",
        "channel",
        "provider",
        "idempotencyKey",
        "taxPointDate",
        "currency",
        "counterparty",
        "lines",
        "fees",
        "providerCollectedTax",
        "totals"
      ],
      "properties": {
        "evidenceClass": {
          "$ref": "#/$defs/evidenceClass"
        },
        "booksOf": {
          "$ref": "#/$defs/booksOf"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "taxPointDate": {
          "$ref": "#/$defs/calendarDate"
        },
        "currency": {
          "$ref": "#/$defs/currencyCode"
        },
        "counterparty": {
          "$ref": "#/$defs/counterparty"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/saleLine"
          }
        },
        "fees": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/fee"
          }
        },
        "providerCollectedTax": {
          "$ref": "#/$defs/minorUnits",
          "description": "Tax the provider collected and remits itself (e.g. eBay eBayCollectedTaxAmount). Memo only: never ours, never posted."
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gross",
            "fees",
            "net"
          ],
          "properties": {
            "gross": {
              "$ref": "#/$defs/minorUnits"
            },
            "fees": {
              "$ref": "#/$defs/minorUnits"
            },
            "net": {
              "$ref": "#/$defs/signedMinorUnits"
            }
          }
        }
      }
    },
    "saleRefundedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceClass",
        "booksOf",
        "channel",
        "provider",
        "idempotencyKey",
        "saleIdempotencyKey",
        "taxPointDate",
        "currency",
        "reason",
        "lines",
        "feeCredits",
        "providerCollectedTaxRefunded",
        "totals"
      ],
      "properties": {
        "evidenceClass": {
          "$ref": "#/$defs/evidenceClass"
        },
        "booksOf": {
          "$ref": "#/$defs/booksOf"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "saleIdempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "taxPointDate": {
          "$ref": "#/$defs/calendarDate"
        },
        "currency": {
          "$ref": "#/$defs/currencyCode"
        },
        "reason": {
          "enum": [
            "return",
            "cancellation",
            "partial_refund",
            "goodwill",
            "other"
          ]
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/refundLine"
          }
        },
        "feeCredits": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/feeCredit"
          }
        },
        "providerCollectedTaxRefunded": {
          "$ref": "#/$defs/minorUnits"
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gross",
            "feeCredits",
            "net"
          ],
          "properties": {
            "gross": {
              "$ref": "#/$defs/minorUnits"
            },
            "feeCredits": {
              "$ref": "#/$defs/minorUnits"
            },
            "net": {
              "$ref": "#/$defs/signedMinorUnits"
            }
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "aggregateId",
        "aggregateType",
        "version",
        "occurredAt",
        "metadata",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuidV5"
        },
        "type": {
          "type": "string"
        },
        "aggregateId": {
          "$ref": "#/$defs/uuidV5"
        },
        "aggregateType": {
          "const": "Sale"
        },
        "version": {
          "const": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/instant"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "saleRecordedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": {
          "const": "commerce.sale.recorded"
        },
        "payload": {
          "$ref": "#/$defs/saleRecordedPayload"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    "saleRefundedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": {
          "const": "commerce.sale.refunded"
        },
        "payload": {
          "$ref": "#/$defs/saleRefundedPayload"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  }
}
