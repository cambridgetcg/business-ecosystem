# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-strong-random-key

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting
DB_USER=accounting
DB_PASSWORD=your-secure-password-here
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20
DB_ECHO=false

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=http://localhost:4566  # Uncomment for LocalStack

# Accounting Defaults
DEFAULT_CURRENCY=USD
DECIMAL_PRECISION=4
FISCAL_YEAR_START_MONTH=1

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
