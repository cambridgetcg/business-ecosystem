{
  "name": "@ecosystem/kyc-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "zod": "^3.22.0",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.0",
    "tsyringe": "^4.8.0",
    "reflect-metadata": "^0.2.0",
    "pino": "^8.19.0",
    "@t3-oss/env-core": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.3.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^6.0.0",
    "testcontainers": "^10.7.0",
    "drizzle-kit": "^0.20.0"
  }
}
