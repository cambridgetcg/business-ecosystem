{
  "name": "@ecosystem/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/http-proxy": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "@ecosystem/observability": "workspace:*",
    "@ecosystem/logging": "workspace:*",
    "@ecosystem/health": "workspace:*",
    "@ecosystem/service-auth": "workspace:*",
    "zod": "^3.22.0",
    "pino": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0"
  }
}
